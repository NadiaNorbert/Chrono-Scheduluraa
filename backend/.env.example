# ── Database ──────────────────────────────────────────────────────
# Full async connection URL for SQLAlchemy
DATABASE_URL=postgresql+asyncpg://chrono_user:chrono_pass@db:5432/chrono_db

# PostgreSQL service credentials (used by Docker Compose)
POSTGRES_DB=chrono_db
POSTGRES_USER=chrono_user
POSTGRES_PASSWORD=chrono_pass

# ── Clerk Authentication ───────────────────────────────────────────
# JWKS endpoint from your Clerk dashboard → API Keys → Advanced
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json

# ── Application ───────────────────────────────────────────────────
# Frontend origin for CORS — no trailing slash
FRONTEND_URL=http://localhost:3000

# development | staging | production
ENVIRONMENT=development

# ── [FUTURE M3] Google Gemini AI ──────────────────────────────────
# GEMINI_API_KEY=your_gemini_api_key_here

# ── [FUTURE M3] Redis (background workers + caching) ──────────────
# REDIS_URL=redis://localhost:6379/0

# ── [FUTURE M3] Email notifications (SendGrid) ────────────────────
# SENDGRID_API_KEY=your_sendgrid_key_here

# ── [FUTURE M4] Observability ─────────────────────────────────────
# SENTRY_DSN=https://your_sentry_dsn_here
# DATADOG_API_KEY=your_datadog_key_here

# ── [FUTURE M5] Real-time collaboration ───────────────────────────
# ABLY_API_KEY=your_ably_key_here

# ── [FUTURE M5] Cloudinary media storage ──────────────────────────
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

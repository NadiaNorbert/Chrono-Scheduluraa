# ── Copy this file to .env and fill in your values ────────────────
# cp .env.example .env

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_DB=chrono_db
POSTGRES_USER=chrono_user
POSTGRES_PASSWORD=chrono_pass
DATABASE_URL=postgresql+asyncpg://chrono_user:chrono_pass@db:5432/chrono_db

# ── Clerk Auth ────────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ── API ───────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# ── [FUTURE M3] Google Gemini AI ──────────────────────────────────
# GEMINI_API_KEY=your_gemini_api_key_here

# ── [FUTURE M3] Redis ─────────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0

# ── [FUTURE M3] Email ─────────────────────────────────────────────
# SENDGRID_API_KEY=your_sendgrid_key_here

# ── [FUTURE M4] Monitoring ────────────────────────────────────────
# SENTRY_DSN=https://your_sentry_dsn_here

# ── [FUTURE M5] Collaboration / Storage ───────────────────────────
# ABLY_API_KEY=your_ably_key_here
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ── [FUTURE M5] Next.js public keys ───────────────────────────────
# NEXT_PUBLIC_AI_ENABLED=false
# NEXT_PUBLIC_ABLY_KEY=your_ably_public_key_here
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
